{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    // "target": "esnext",
    "target": "es2016",
    "jsx": "react-jsx", // Not needed for Node.js backend. Can be removed.
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".", // Set rootDir to the project root
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "./tests"]
  },
  "include": ["**/*.ts"], // Include all TypeScript files in the project
  "exclude": ["node_modules", "dist", "React Apps", "templates"]
}
