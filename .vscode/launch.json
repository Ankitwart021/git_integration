{
    "version": "0.2.0",
    "configurations": [
        
    {
       "type": "node",
       "request": "launch",
       "name": "Launch Program (ts-node)",
       "runtimeArgs": [
        "--require",
        "ts-node/register"
       ],
       "args": [
       "${workspaceFolder}/server.ts"
       ],
       "cwd": "${workspaceFolder}",
       "protocol": "inspector",
       "internalConsoleOptions": "openOnSessionStart",
       "skipFiles": [
        "<node_internals>/**"
       ]
    }
   ]
}
