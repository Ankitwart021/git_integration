import React, { useEffect } from "react";
import apiConfig from "../../config/apiConfig";
import { useQuery } from "@tanstack/react-query";

import { useRaspStore } from "../../store/raspStore";
import Cookies from "js-cookie";
import { jwtDecode } from "jwt-decode";

// 🔥 IMPORTANT: import generated collection directly
import <%=collectionComponentName%> from "../../collections/<%=collectionComponentName%>";


// Model
import <%=resourceName%>Model from "../../models/<%=resourceName%>Model";

const getCookie = (name: string): string | null => {
  const value = `; ${document.cookie}`;
  const parts = value.split(`; ${name}=`);
  if (parts.length === 2) return parts.pop()?.split(";").shift() || null;
  return null;
};

const Read<%= resourceName %><%= viewMode %> = () => {
  const initializeStore = useRaspStore((s) => s.initializeStore);

  const getUserIdFromJWT = (): any => {
    try {
      const token = Cookies.get("access_token");
      if (!token) return null;
      const decoded: any = jwtDecode(token);
      return decoded.userId || decoded.sub || null;
    } catch {
      return null;
    }
  };

  /* ---------------- Fetch Resource Data (ONCE) ---------------- */
  const { data } = useQuery({
    queryKey: ["resourceData", "<%=resourceName.toLowerCase()%>", "<%=viewMode%>"],
    queryFn: async () => {
      const params = new URLSearchParams();
      params.append("queryId", "GET_ALL");

      const accessToken = getCookie("access_token");
      if (!accessToken) throw new Error("Access token not found");

      const response = await fetch(
        `${apiConfig.getResourceUrl("<%=resourceName.toLowerCase()%>")}?${params}`,
        {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${accessToken}`,
          },
          credentials: "include",
        }
      );

      if (!response.ok) {
        throw new Error("Failed to fetch resource data");
      }

      const json = await response.json();
      return json.resource || [];
    },
  });

  /* ---------------- Initialize RASP Store ---------------- */
  useEffect(() => {
    if (!data) return;

    const models = data.map((obj: any) =>
      <%=resourceName%>Model.fromJson(obj)
    );

    const jsonRecords = models.map((m: any) => m.toJson());

    initializeStore(getUserIdFromJWT(), {
      resource: "<%=resourceName.toLowerCase()%>",
      records: jsonRecords,
    });
  }, [data]);

  /* ---------------- Render Collection ---------------- */
  return (
    <div>
      <<%=collectionComponentName%> />
    </div>
  );
};

export default Read<%= resourceName %><%= viewMode %>;
