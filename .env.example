# API Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Application Settings
MAX_CONCURRENT_SCANS=3
SUPPORTED_LANGUAGES=python,java,javascript,typescript,go
SCAN_TIMEOUT=300
CALLBACK_RETRY_COUNT=3
CALLBACK_RETRY_BACKOFF=5

# SonarQube Integration
SONAR_URLS=http://localhost:9001,http://localhost:9002,http://localhost:9003
SONAR_TOKENS=insert_token_1,insert_token_2,insert_token_3
SONAR_WEBHOOK_SECRET=my_webhook_secret
DEFAULT_PROJECT_KEY_PREFIX=vs-verify-

SONAR_INSTANCES={"http://localhost:9001": "insert_token_1"}
