class <%= className %>Model {
<% keys.forEach(function(key) { %>
  private _<%= key %>: any;
<% }) %>

  constructor(data: any) {
<% keys.forEach(function(key) { %>
    this._<%= key %> = data["<%= key %>"];
<% }) %>
  }

<% keys.forEach(function(key) { 
  const capKey = key.charAt(0).toUpperCase() + key.slice(1);
%>
  public get<%= capKey %>(): any {
    return this._<%= key %>;
  }

  public set<%= capKey %>(value: any) {
    this._<%= key %> = value;
  }

<% }) %>

  public toJson(): any {
    return {
<% keys.forEach(function(key) { %>
      "<%= key %>": this._<%= key %>,
<% }) %>
    };
  }

  public static fromJson(json: any): <%= className %>Model {
    return new <%= className %>Model(json);
  }
}

export default <%= className %>Model;
